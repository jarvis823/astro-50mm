---
import Landing from '@/layouts/Landing.astro';
import Hero from '@/components/landing/Hero.astro';
import LiveFeed from '@/components/landing/LiveFeed.astro';
import About from '@/components/landing/About.astro';
import SnapZone from '@/components/landing/SnapZone.astro';
import Features from '@/components/landing/Features.astro';
import CallToAction from '@/components/landing/CallToAction.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '@/consts';
---

<Landing title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Hero />
	<LiveFeed />
	<About />
	<SnapZone />
	<Features />
	<CallToAction />
</Landing>
