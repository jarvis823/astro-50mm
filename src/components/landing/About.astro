<span class="material-symbols-outlined text-6xl">distance</span>
</div>
<p class="font-label text-sm text-outline tracking-widest mb-4">SHARED_LOCATIONS</p>
<div class="font-headline text-7xl font-black text-on-surface tracking-tighter">12,402</div>
<div class="mt-6 h-1 w-24 bg-primary group-hover:w-full transition-all duration-500"></div>
</div>
